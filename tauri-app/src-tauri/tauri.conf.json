{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIAMBRUK",
  "version": "0.1.1",
  "identifier": "siambruk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIAMBRUK",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MDlBNjdBRjFDNUNEOUQKUldTZHpjWHhlcVlKU0wweTAzUWFoMG5ZL1VuY2xHNUp6cTRFTzdzbUlBVWdjQkhpR1dERjRkT1kK",
      "endpoints": [
        "https://github.com/Karuki00/SIAMBRUK/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
